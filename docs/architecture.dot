// What runs in a k0rdent management cluster, by namespace. Render with:
//   dot -Tsvg docs/architecture.dot -o docs/architecture.svg
//
// Each namespace box has two columns: the workloads that run there, and the
// CRDs those workloads own. CRDs are cluster-scoped -- they are placed with
// their owner, not inside a namespace.
//
// Only the edges that cross a namespace are drawn. Within a namespace almost
// everything talks to everything, and drawing that would say nothing.

digraph cluster_layout {
  rankdir=TB;
  compound=true;
  fontname="Helvetica";
  graph [fontname="Helvetica"];
  node [fontname="Helvetica", fontsize=9, shape=box, style="filled", color="#00000000", margin="0.12,0.06"];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  subgraph cluster_mgmt {
    label="k0rdent Management Cluster";
    fontsize=15;
    labeljust="l";
    style="rounded,filled";
    fillcolor="#fbfbfb";
    color="#999999";
    penwidth=2;

    // ================= kcm-system =====================================
    subgraph cluster_kubesystem {
      label="namespace: kube-system";
      fontsize=12; labeljust="l";
      style="rounded,filled"; fillcolor="#f2f2f2"; color="#cccccc";

      subgraph cluster_ks_wl {
        label="Deployments and DaemonSets";
        fontsize=10; labeljust="l";
        style="rounded,filled"; fillcolor="#e8e8e8"; color="#cccccc";

        ks_dns   [fillcolor="#e0e0e0", label="coredns"];
        ks_ms    [fillcolor="#e0e0e0", label="metrics-server"];
        ks_net   [fillcolor="#e0e0e0", label="kube-proxy, kube-router,\nkonnectivity-agent"];
      }
    }

    subgraph cluster_sveltos {
      label="namespace: projectsveltos";
      fontsize=12; labeljust="l";
      style="rounded,filled"; fillcolor="#faf3e0"; color="#e0d6b8";

      subgraph cluster_sv_crd {
        label="CRDs owned here (cluster-scoped)";
        fontsize=10; labeljust="l";
        style="rounded,filled"; fillcolor="#e8f0f8"; color="#b8cde0";

        crd_sv_cfg [fillcolor="#dce8f7", label="config.projectsveltos.io\nClusterProfile, Profile,\nClusterSummary, ClusterConfiguration"];
        crd_sv_lib [fillcolor="#dce8f7", label="lib.projectsveltos.io\nSveltosCluster, RoleRequest,\nClassifier, EventSource, …"];
      }

      subgraph cluster_sv_wl {
        label="Deployments";
        fontsize=10; labeljust="l";
        style="rounded,filled"; fillcolor="#f5ead1"; color="#e0d6b8";

        sv_addon [fillcolor="#eccf8a", penwidth=1.5, color="#c9a552", label="addon-controller"];
        sv_access[fillcolor="#f3e2b8", label="access-manager"];
        sv_shard [fillcolor="#f3e2b8", label="shard-controller"];
        sv_agent [fillcolor="#f3e2b8", label="sveltos-agent-manager"];
        sv_rest  [fillcolor="#f3e2b8", label="classifier-manager, event-manager,\nhc-manager, sc-manager,\ntechsupport-controller, mcp-server"];
      }
    }

    subgraph cluster_kcmsystem {
      label="namespace: kcm-system";
      fontsize=12; labeljust="l";
      style="rounded,filled"; fillcolor="#eef4ea"; color="#a8c898";

      subgraph cluster_kcm_crd {
        label="CRDs owned here (cluster-scoped)";
        fontsize=10; labeljust="l";
        style="rounded,filled"; fillcolor="#e8f0f8"; color="#b8cde0";

        crd_inst [fillcolor="#d2e3f2", label="k0rdent.mirantis.com — install\nRelease, Management, Region"];
        crd_tpl  [fillcolor="#d2e3f2", label="k0rdent.mirantis.com — templates\nCluster/Service/ProviderTemplate\n+ TemplateChains"];
        crd_cd   [fillcolor="#d2e3f2", label="k0rdent.mirantis.com — clusters\nClusterDeployment, Credential,\nClusterIPAM(Claim), RBACPolicy"];
        crd_ksm  [fillcolor="#d2e3f2", label="k0rdent.mirantis.com — services\nMultiClusterService, ServiceSet,\nStateManagementProvider"];
        crd_flux [fillcolor="#dce8f7", label="*.toolkit.fluxcd.io\nHelmRelease, HelmRepository,\nHelmChart"];
        crd_capi [fillcolor="#dce8f7", label="cluster.x-k8s.io\nCluster, Machine, MachineSet, …"];
        crd_vel  [fillcolor="#dce8f7", label="velero.io\nBackup, Schedule, Restore"];
      }

      subgraph cluster_kcm_wl {
        label="Deployments";
        fontsize=10; labeljust="l";
        style="rounded,filled"; fillcolor="#dfeed6"; color="#bcd6ac";

        kcm_mgr   [fillcolor="#8fc47a", penwidth=1.5, color="#5f9448", label="kcm-controller-manager"];
        kcm_src   [fillcolor="#cfe6c0", label="source-controller"];
        kcm_helm  [fillcolor="#cfe6c0", label="helm-controller"];
        kcm_capi  [fillcolor="#cfe6c0", label="capi-controller-manager"];
        kcm_capiop[fillcolor="#cfe6c0", label="kcm-cluster-api-operator"];
        kcm_cert  [fillcolor="#cfe6c0", label="kcm-cert-manager\n+ cainjector + webhook"];
        kcm_rbac  [fillcolor="#cfe6c0", label="kcm-rbac-manager"];
        kcm_rel   [fillcolor="#cfe6c0", label="kcm-reloader"];
        kcm_vel   [fillcolor="#cfe6c0", label="velero"];
        // only rendered when telemetry.mode is not "disabled"
        kcm_tel   [fillcolor="#cfe6c0", style="filled,dashed", color="#8fae7f",
                   label="telemetry\n(unless mode=disabled)"];
      }
    }
  }

  Child [fillcolor="#e8dcf7", style="filled", shape=box3d, fontsize=11, label="Child clusters"];


  // Invisible chains: without them the members of a column land on one rank and
  // the "columns" come out as rows.
  edge [style=invis, weight=10];
  kcm_mgr -> kcm_src -> kcm_helm -> kcm_capi -> kcm_capiop -> kcm_cert -> kcm_rbac -> kcm_rel -> kcm_vel -> kcm_tel;
  crd_inst -> crd_tpl -> crd_cd -> crd_ksm -> crd_flux -> crd_capi -> crd_vel;
  sv_addon -> sv_access -> sv_shard -> sv_agent -> sv_rest;
  crd_sv_cfg -> crd_sv_lib;
  ks_dns -> ks_ms -> ks_net;
  edge [style=solid, weight=1];


  // ---- only what crosses a namespace ------------------------------------
  kcm_mgr -> crd_flux  [constraint=false, label="renders HelmRelease"];
  kcm_helm -> sv_addon [constraint=false, lhead=cluster_sveltos, label="installs Sveltos"];
  kcm_mgr -> crd_sv_cfg [constraint=false, label="writes Profile"];
  crd_sv_cfg -> sv_addon [constraint=false, label="acted on by"];
  sv_addon -> Child [constraint=false, label="installs services"];
  kcm_capi -> Child [constraint=false, label="provisions"];
}
